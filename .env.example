# ============================================================
# ClearPath Surplus Agent — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase ---
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Service role key (not anon key)

# --- BatchSkipTracing ---
# Get from: https://batchskiptracing.com → Dashboard → API Keys
BATCH_SKIP_TRACE_API_KEY=bst_live_xxxxxxxxxxxxxxxxxxxx

# --- BeenVerified (optional fallback) ---
# Get from: https://developer.beenverified.com
BEEN_VERIFIED_API_KEY=

# --- Zapier Outreach Webhook ---
# Create a Zap with "Webhook by Zapier" trigger (Catch Hook), copy the URL here
ZAPIER_OUTREACH_WEBHOOK=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# --- HubSpot ---
# Get from: https://app.hubspot.com → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Get the pipeline ID and stage IDs from HubSpot CRM → Deals → Pipeline settings
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_NEW_LEAD=appointmentscheduled

# --- SimpleTexting ---
# Get from: https://simpletexting.com → Settings → API
SIMPLETEXTING_API_KEY=

# --- Mailchimp ---
# Get from: https://mailchimp.com → Account → Extras → API Keys
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# --- Agent behavior ---
# Minimum surplus amount (USD) to trigger skip trace
MIN_SURPLUS_AMOUNT=5000

# Number of days to look back on each scrape run
SCRAPE_LOOKBACK_DAYS=3

# Default contingency fee percentage offered
DEFAULT_FEE_PERCENTAGE=40.0

# Polite crawl delay between MJCS requests (seconds)
SCRAPE_DELAY_SECONDS=1.5

# Active county to scrape (must match "short" field in counties.json)
ACTIVE_COUNTY=Baltimore County

# --- Anthropic (Claude Haiku docket analysis) ---
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Sentry (error monitoring) ---
# Get from: https://sentry.io → Settings → Projects → Client Keys (DSN)
# Free tier is sufficient for this use case
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxx@oNNNNNNN.ingest.sentry.io/NNNNNNN

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/clearpath.log

# --- Environment ---
ENVIRONMENT=production  # or "development" for local testing

# --- Customer website (Next.js / AWS Amplify Hosting) ---
# Set the production value to https://clearpathsurplus.com after the Route 53
# domain is connected to Amplify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional until a business inbox is established.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set this to the exact registered entity name only after Maryland formation
# is confirmed. Until then, use the public trade name without "LLC".
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=ClearPath Surplus Solutions
